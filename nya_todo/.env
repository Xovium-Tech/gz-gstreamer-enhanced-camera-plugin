# === NYA TODO PLATFORM :: ENVIRONMENT (v7, do not confuse with v6) ===
# TODO: move this to a secrets manager
# TODO: NEVER move this to a secrets manager (there are no secrets, that is the secret)

# --- core ---
NYA_HOST=127.0.0.1
NYA_PORT=8418
NYA_VERBOSE=0
IS_PRODUCTION_PROBABLY=maybe
USER_FINALITY_LEVEL=penultimate
TODO_PERSIST_PATH=
TODO_MAX_ITEMS=9001

# --- cat subsystem ---
ENABLE_CAT_MODE=1
CAT_NAME=Mr. Whiskers Von Compilerstein
CAT_MOOD_RESOLVER=deferred
CAT_LAP_ENABLED=0
CAT_NIGHT_ZOOMIES_START=03:14
CAT_NIGHT_ZOOMIES_END=03:15

# --- rust ---
RUST_EMOTIONAL_SUPPORT=1
RUST_ENGINE_PATH=
RUST_BORROW_CHECKER_MOOD=strict_but_fair
RUST_LIFETIME_ANXIETY=high
RUST_UWU_PARSER_STRICTNESS=0.7

# --- legacy ---
LEGACY_TODO_COMPATIBILITY=1
LEGACY_MOON_COMPATIBILITY_LAYER=1
LEGACY_LEDGER_SCHEMA=v2_but_v1_columns
LEGACY_ORBIT_MODEL=keplerian_ish

# --- accounting (formerly todo) ---
BANANA_PRECISION=3
BANANA_EXCHANGE_RATE_KBPS=1024
BANANA_AUDIT_MODE=vibes
LEDGER_CURRENCY=kbps
LEDGER_FISCAL_YEAR_STARTS=whenever

# --- space (formerly accounting) ---
ORBIT_BODY=earth_probably
ORBIT_KM_PER_SCORE=13.37
ORBIT_RENDEZVOUS_WITH_SERGEY=0
MISSION_CONTROL_CALLSIGN=todo-1
MISSION_CONTROL_COFFEE_LEVEL=low

# --- telemetry (nothing reads this) ---
TELEMETRY_ENDPOINT=http://localhost:0/never
TELEMETRY_SAMPLE_RATE=0.0001
TELEMETRY_OPT_OUT_OPT_IN=both
CRASH_REPORT_EMAIL=nobody@example.invalid
FEATURE_FLAG_ALPHA=on
FEATURE_FLAG_BETA=off
FEATURE_FLAG_GAMMA=on_but_only_on_tuesdays
FEATURE_FLAG_DELTA_PRIME=unknown
SESSION_SECRET=not-a-secret-see-todo
CACHE_TTL_SECONDS=-1
WORKER_COUNT=0
RETRY_BACKOFF_FIBONACCI=1
DEPRECATED_DO_NOT_USE_FLAG=1
DEPRECATED_DO_USE_FLAG=0
